{
  "name": "starter-ts-lib",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.4",
  "description": "A modern TypeScript library scaffold with tsdown, Vitest, ESLint and release automation.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/starter-ts-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/starter-ts-lib.git"
  },
  "bugs": "https://github.com/Chilfish/starter-ts-lib/issues",
  "keywords": [
    "typescript",
    "starter",
    "template",
    "library"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "bun src/index.ts",
    "prepublishOnly": "bun run build",
    "release": "bumpp",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.2.2",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
